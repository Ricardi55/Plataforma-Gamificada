{
  "info": {
    "name": "MutAPI nivel 12 - ejemplo resuelto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/practice/12",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Postman: campo id obligatorio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana@example.test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Detecta el cambio del mutante\", function () {",
              "  pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}